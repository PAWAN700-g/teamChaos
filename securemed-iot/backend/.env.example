# SecureMed IoT Backend Configuration Template
# Copy this file to .env and adjust values for your local environment

PROJECT_NAME="SecureMed IoT Gateway"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# Server Host and Port
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080,http://localhost:5000"

# Cryptographic Keys & Master Secret
# Prototype secret (change in production or staging)
SECRET_KEY="insecure-hackathon-secret-key-change-in-production"
PQC_ALGORITHM_KEM="ML-KEM-768"
PQC_ALGORITHM_DSA="ML-DSA-65"
SYMMETRIC_CIPHER="AES-256-GCM"

# Firebase Credentials (Optional for local mockup, required for cloud auth & Firestore sync)
FIREBASE_CREDENTIALS_PATH=""
FIREBASE_PROJECT_ID="securemed-iot-demo"
