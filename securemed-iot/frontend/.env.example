# Frontend Environment Variables Template
# Copy this file to .env or inject as compile-time flags (--dart-define)

API_BASE_URL=http://localhost:8000/api/v1
WS_STREAM_URL=ws://localhost:8000/api/v1/ws/stream

# Firebase Web / Mobile Configuration
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=securemed-iot-demo.firebaseapp.com
FIREBASE_PROJECT_ID=securemed-iot-demo
FIREBASE_STORAGE_BUCKET=securemed-iot-demo.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
