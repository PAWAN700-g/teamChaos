# ==========================================
# SecureMed IoT - Monorepo Environment Variables
# ==========================================

# Backend Gateway
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=true
BACKEND_SECRET_KEY=hackathon-prototype-secret-key-change-me

# Cryptography Settings
PQC_KEM_ALGORITHM=ML-KEM-768
PQC_DSA_ALGORITHM=ML-DSA-65
SYMMETRIC_CIPHER=AES-256-GCM

# Frontend & Dashboard
FRONTEND_API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_WS_URL=ws://localhost:8000/api/v1/ws/stream

# Firebase & Firestore Configuration
FIREBASE_PROJECT_ID=securemed-iot-demo
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=securemed-iot-demo.firebaseapp.com
FIREBASE_CREDENTIALS_PATH=

# Device Simulator
SIMULATOR_GATEWAY_URL=http://localhost:8000/api/v1
SIMULATOR_DEVICE_ID=MED-DEV-ICU-701A
SIMULATOR_INTERVAL_SECONDS=2.0
SIMULATE_ATTACK=false
